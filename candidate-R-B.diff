@@ -74,6 +74,7 @@ mutable struct ProximalGradientDescentState{T, X<:Vector{T}, G<:Vector{T}, M, Z}
     z_x::Z            # A x
     dz::Z             # F' at A x; buffer of the product A d of a checked rejection
     verifications::Int  # rejections checked by the computed curvature (one product A d each)
+    verified_rejection::Bool  # #308: the last rejection of this iteration was decided by its computed curvature
 end
 
 
@@ -114,7 +115,8 @@ function initial_state(
                          model,
                          z_x,
                          dz,
-                         0
+                         0,
+                         false
                          )
 end
 
@@ -130,6 +132,7 @@ function update_state!(
     state.g_x_previous = state.g_x
     _copyto!(state.grad_f_x_previous, state.grad_f_x)
     state.L *= method.ls.α
+    state.verified_rejection = false
 
     # backtracking loop
     while true
@@ -276,3 +279,9 @@ function solve!(x, f, g, method::ProximalGradientDescent,
   state = initial_state(method, options, f, g, x)
   _solve_gradient!(state, f, g, method, options, t0)
 end
+
+# #308: Float32 PGD with ftol = 0 stops, without convergence, at an exact stall whose step size
+# was set by the computed curvature of a rejected representable step in the same iteration.
+_stagnated(state, options) = false
+_stagnated(state::ProximalGradientDescentState{Float32}, options) =
+  iszero(options.ftol) && state.verified_rejection && _unchanged(state.x, state.x_previous)
