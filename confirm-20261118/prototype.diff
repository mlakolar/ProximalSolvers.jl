+# ---------------------------------------------------------------------------------------------------
+# Research prototype for the #155 confirmation round (not production code): smoothing continuation with
+# a bank of dual bounds after an uncertified stop. Schedule, budget and return rule as preregistered.
+const _FALLBACK = Ref(:d2)               # research toggle: :d2 or :off
+const _FALLBACK_DUAL = Ref{Any}(nothing) # research only (M1g): extra dual bound f(m, x)::Float64
+const _FALLBACK_LOG = Ref{Any}(nothing)  # research only: a Vector that receives one record per fallback
+_fallback_ratio(P::Float64, D::Float64) = D > 0 ? _up(_up(P - D)/D) : Inf
+# The certificate at x, and the bank D raised by its dual lower bound (and the research hook's).
+function _fallback_bank!(m::SqrtLSModel, x, D::Float64)
+  _certify!(m, x)
+  isfinite(m.cdlo) && (D = max(D, m.cdlo))
+  f = _FALLBACK_DUAL[]
+  if f !== nothing
+    d = f(m, x)
+    isfinite(d) && (D = max(D, d))
+  end
+  D
+end
+function _fallback!(m::SqrtLSModel{T}, g, x::SparseIterate{T}, st, s::CDSolver) where T
+  _FALLBACK[] === :off && return nothing
+  base = st.passes
+  budget = min(s.maxpasses - base, max(2000, 20base))
+  budget > 0 || return nothing
+  t0 = time_ns()
+  D = _fallback_bank!(m, x, 0.0)
+  P0, L0 = m.cpup, m.cplo
+  # review r1, finding 2: no schedule without finite bounds and a positive finite δ₀ in T
+  (isfinite(P0) && isfinite(L0) && P0 > 0 && isfinite(T(P0))) || return nothing
+  x0 = copy(x)
+  Fbest, δ, used, stage = P0, P0, 0, 0
+  certified, via, ratio, maxh, tol = false, :none, Inf, st.maxchange, st.tolerance
+  while true
+    stage += 1
+    polish = stage > 8
+    m.δ64 = polish ? 0.0 : Float64(T(δ))
+    m.δ2 = T(m.δ64)^2
+    m.tightenings, m.gap, m.uncertified = 0, T(NaN), false
+    sub = CDSolver(budget - used, s.tol, s.random, s.relative, s.momentum, s.rng)
+    sst = _CDState(T, x, sub)
+    _cd!(x, m, g, sst, sub)
+    used += sst.passes
+    maxh, tol = sst.maxchange, sst.tolerance
+    m.δ64, m.δ2 = 0.0, zero(T)
+    D = _fallback_bank!(m, x, D)
+    Pb = m.cpup
+    Fbest = min(Fbest, Pb)
+    r0 = _fallback_ratio(P0, D)
+    if r0 <= _CERT_TARGET
+      copyto!(x, x0)
+      initialize!(m, x)
+      certified, via, ratio = true, :x0, r0
+      break
+    end
+    rb = _fallback_ratio(Pb, D)
+    if rb <= _CERT_TARGET && Pb < L0
+      certified, via, ratio = true, polish ? :polish : :stage, rb
+      break
+    end
+    if polish || used >= budget
+      if Pb < L0
+        via, ratio = :improved, rb
+      else
+        copyto!(x, x0)
+        initialize!(m, x)
+        via, ratio = :kept, r0
+      end
+      break
+    end
+    δ = min(δ/5, Fbest)
+  end
+  st.passes, st.converged, st.maxchange, st.tolerance = base + used, certified, maxh, tol
+  m.uncertified = !certified
+  m.gap = certified ? T(ratio, RoundUp) : T(NaN)
+  lg = _FALLBACK_LOG[]
+  lg === nothing || push!(lg, (; base, budget, used, stages = stage, certified, via, ratio, P0, L0, D, secs = (time_ns() - t0)/1e9))
+  nothing
+end
