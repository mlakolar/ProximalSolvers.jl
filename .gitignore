# Generated master dependency test environments
.master-test-env/

# Local Julia-minor environments are regenerated from master checkouts
/Manifest-v*.toml
# The Julia 1.10 manifest pins the ProximalBase development commit until 0.6.0 is registered
!/Manifest-v1.10.toml

# Local run material of the codex orchestrator (journals, prompts, logs, depots)
/.codex-orchestrator/

# One-off audit and benchmark output stays outside git.
# Already-tracked historical artifacts remain tracked until a separate cleanup.
/docs/audit/**/results/
/docs/audit/**/artifacts/
/docs/audit/**/evidence/
/benchmark/**/results/
/benchmark/**/artifacts/
