diff --git a/src/utils.jl b/src/utils.jl
index 5f0c10a..f7f67c2 100644
--- a/src/utils.jl
+++ b/src/utils.jl
@@ -66,3 +66,14 @@ end
 
 _state_norm(s::ProximalGradientDescentState, x) = _norm(x)
 _state_normdiff(s::ProximalGradientDescentState) = _norm_diff(s.x, s.x_previous, 2.)
+
+# The trial point x = prox_{g/L}(base - ∇f(base)/L) of both line searches and its value; the base point is
+# x_previous for PGD and y for APG, and `grad` is the gradient there.
+function _trial_point!(state::Union{ProximalGradientDescentState{T}, AccProxGradDescentState{T}}, g, base, grad) where T
+  _step!(state.xhat, base, grad, state.L)
+  state.g_x = convert(T, value_and_prox!(state.x, g, state.xhat, one(state.L) / state.L))
+  state.f_x = _value!(state.x, state.model, state.z_x)
+  state.prox_calls += 1
+  state.f_calls += 1
+  state
+end
