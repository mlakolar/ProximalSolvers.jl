+
+# The dense gradient-method solve!: validation, the method's own checks, the start and the engine.
+function _solve_dense!(x, f, g, method, options, kwargs)
+  _check_keywords(kwargs)
+  _check_problem(x, f, g)
+  _check_method_for(method, f, x)
+  t0 = time()
+  state = initial_state(method, options, f, g, x)
+  _solve_gradient!(state, f, g, method, options, t0)
+end
